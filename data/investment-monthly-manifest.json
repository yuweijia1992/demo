      "source_sha": "9c3d5e73fe44b2490d1685d0a0818db4802fbb46",
      "coverage_start": "1960-01",
      "coverage_end": "2026-10",
      "method": "Monthly average USD per troy ounce; CNY level proxy = USD monthly average × USD/CNY monthly average",
      "license": "ODC-PDDL per upstream repository",
      "caveat": "Price-only series; CNY returns are based on product of two monthly averages, not paired daily observations."

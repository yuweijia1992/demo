      "source_sha": "d886bec02084df56ddb12bdcb0856874976c76d9",
      "coverage_start": "2005-09",
      "coverage_end": "2026-09-09",
      "method": "Last available daily close per month; CSI300 is price index and CSI300_TR is total-return index built against official H00300",
